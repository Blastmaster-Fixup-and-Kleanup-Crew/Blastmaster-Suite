        <file>edit/copy.svg</file>
        <file>edit/paste.svg</file>
        <file>edit/find.svg</file>
        <file>edit/replace.svg</file>

        <!-- Format -->
        <file>format/bold.svg</file>
        <file>format/italic.svg</file>
        <file>format/underline.svg</file>
        <file>format/font.svg</file>
        <file>format/bullets.svg</file>

        <!-- Draw -->
        <file>draw/line.svg</file>
        <file>draw/rectangle.svg</file>
        <file>draw/oval.svg</file>
        <file>draw/text_box.svg</file>
        <file>draw/fill.svg</file>
